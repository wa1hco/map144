.DS_Store
Thumbs.db

# Local working copy of DSP / decode reliability plan (canonical: docs/dsp-reliability-plan.example.md)
docs/dsp-reliability-plan.md

# Vendored WDSP build artifacts (source is tracked; binaries rebuild locally)
vendor/wdsp/*.o
vendor/wdsp/*.so

# Fortran-vs-Python decoder cross-check (source is tracked; build locally with gfortran)
fortran_bp_test/*.o
fortran_bp_test/*.mod
fortran_bp_test/bp_test
fortran_bp_test/mf_test


# Intentional documentation figures — override the global *.png
!docs/figures/
!docs/figures/*.png
