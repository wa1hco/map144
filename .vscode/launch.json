{
    // https://code.visualstudio.com/docs/python/debugging
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: map144",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/map144.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": ["--log-level", "INFO"]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python"
        },
        {
            "name": "Python Debugger: generate_msk144",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/generate_msk144.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "--count",
                "10",
                "--skip-plots"
            ]
        },
        {
            "name": "Python Debugger: decode_sensitivity SPD",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/decode_sensitivity.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "subProcess": true,
            "args": [
                "--spd", "--flat",
                "--snr-min", "5", "--snr-max", "7",
                "--trials", "2",
                "--workers", "1"
            ]
        },
        {
            "name": "Python Debugger: Analyze MSK144",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/analyze_msk144.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": ["${workspaceFolder}/MSK144/181211_120800.wav"]
        }
    ]
}
